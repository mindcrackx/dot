#!/usr/bin/env bash

# Find the real go binary (not this script)
# Remove the script's directory from PATH temporarily
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLEAN_PATH="${PATH//$SCRIPT_DIR:/}"
CLEAN_PATH="${CLEAN_PATH//:$SCRIPT_DIR/}"

# Find go in the cleaned PATH
GO_BIN=$(PATH="$CLEAN_PATH" command -v go)

if [[ -z "$GO_BIN" ]]; then
  echo "Error: go not found in PATH" >&2
  echo "Install go via: mise install go@latest" >&2
  exit 1
fi

exec "$GO_BIN" "$@"
